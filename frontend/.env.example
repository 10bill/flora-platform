# Copie ce fichier en « .env.local » (même dossier) et remplis les valeurs.

# Adresse de l'API (dossier backend/). En local : http://localhost:4000
API_URL=http://localhost:4000

# Mise à jour instantanée du site après une modification dans l'admin (facultatif).
# Même valeur que REVALIDATE_SECRET dans backend/.env. Sans ça, le site se met à jour en 30 secondes.
REVALIDATE_SECRET=
